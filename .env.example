# ==============================================================================
# School ID Card Platform - Environment Configuration Template
# ==============================================================================

# Database Configuration
POSTGRES_DB=school_id_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

# Backend Port & Profile
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Security / JWT
# Minimum 32-byte secret key for HMAC-SHA256 signing
JWT_SECRET=production-grade-school-id-card-platform-jwt-secret-key-32b!
JWT_EXPIRATION_HOURS=24

# File Upload Location
APP_STORAGE_LOCATION=/app/uploads

# Frontend Port
FRONTEND_PORT=80
